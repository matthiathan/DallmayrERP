+++ b/app/monday-shell-phase-1.css
@@ -0,0 +1,1043 @@
+/* Monday-style shell phase 1.
+   Establishes a quiet workspace shell, task-first navigation, one content scroll
+   surface and a responsive notification inbox. Business workflows are unchanged. */
+
+:root {
+  --application-header-height: 60px;
+  --application-rail-width: 248px;
+  --application-rail-collapsed-width: 64px;
+  --monday-shell-bg: var(--content-surface, #20272f);
+  --monday-shell-raised: var(--content-surface-raised, #2b343d);
+  --monday-page-bg: var(--user-background, #0f1419);
+  --monday-text: var(--content-text, #f8fafc);
+  --monday-strong: var(--content-strong, #fff);
+  --monday-muted: var(--content-muted, #cbd5e1);
+  --monday-subtle: var(--content-subtle, #a8b3bf);
+  --monday-border: color-mix(in srgb, var(--content-border, #71808e) 62%, transparent);
+  --monday-divider: color-mix(in srgb, var(--content-border, #71808e) 42%, transparent);
+  --monday-hover: color-mix(in srgb, var(--content-surface-raised, #2b343d) 82%, var(--content-text, #f8fafc));
+  --monday-selected: color-mix(in srgb, var(--content-accent-text, #67e8f9) 13%, var(--content-surface, #20272f));
+  --monday-accent: var(--content-accent-text, #67e8f9);
+}
+
+html {
+  overflow-x: hidden;
+  scrollbar-gutter: stable;
+}
+
+body {
+  overflow-x: hidden;
+  overflow-y: auto;
+}
+
+body::before,
+body::after {
+  opacity: 0.08;
+}
+
+/* Global application bar: logo, search, utilities. Page identity belongs in the board header. */
+.monday-shell-phase-1 .application-header {
+  min-height: var(--application-header-height) !important;
+  border-bottom: 1px solid var(--monday-divider) !important;
+  background: color-mix(in srgb, var(--monday-shell-bg) 98%, transparent) !important;
+  box-shadow: none !important;
+  backdrop-filter: blur(16px) saturate(110%);
+}
+
+.monday-shell-phase-1 .application-header-inner {
+  grid-template-columns: minmax(185px, 230px) minmax(320px, 720px) minmax(150px, 1fr) !important;
+  gap: 14px !important;
+  min-height: var(--application-header-height) !important;
+  padding: 7px 14px !important;
+}
+
+.monday-shell-phase-1 .application-brand {
+  min-height: 44px;
+  padding: 4px 8px 4px 4px;
+  border-radius: 8px;
+  font-size: 0.95rem;
+}
+
+.monday-shell-phase-1 .application-brand-mark {
+  width: 34px;
+  height: 34px;
+  border-radius: 8px;
+}
+
+.monday-shell-phase-1 .application-header-search {
+  min-width: 0;
+}
+
+.monday-shell-phase-1 .application-header-search .global-search-trigger {
+  width: 100% !important;
+  min-height: 42px !important;
+  padding: 9px 13px !important;
+  border: 1px solid var(--monday-divider) !important;
+  border-radius: 8px !important;
+  background: color-mix(in srgb, var(--monday-page-bg) 70%, var(--monday-shell-bg)) !important;
+  color: var(--monday-muted) !important;
+  box-shadow: none !important;
+}
+
+.monday-shell-phase-1 .application-header-search .global-search-trigger:hover,
+.monday-shell-phase-1 .application-header-search .global-search-trigger:focus-visible {
+  border-color: var(--monday-accent) !important;
+  color: var(--monday-strong) !important;
+}
+
+.monday-shell-phase-1 .application-header-actions {
+  justify-self: end;
+  gap: 6px;
+}
+
+.monday-shell-phase-1 .application-header-actions .density-toggle,
+.monday-shell-phase-1 .desktop-alerts-target,
+.monday-shell-phase-1 .desktop-account-menu-target {
+  width: 42px !important;
+  height: 42px !important;
+  flex-basis: 42px !important;
+}
+
+.monday-shell-phase-1 .application-header-actions .density-toggle {
+  border-radius: 8px !important;
+}
+
+.monday-shell-phase-1 .application-page-context {
+  display: none;
+}
+
+/* Desktop workspace rail. */
+@media (min-width: 981px) {
+  html[data-visual-theme] body .monday-shell-phase-1 {
+    min-height: 100dvh !important;
+    padding-top: var(--application-header-height) !important;
+  }
+
+  html[data-visual-theme] body .monday-shell-phase-1 .application-main {
+    width: calc(100% - var(--application-rail-width)) !important;
+    min-height: calc(100dvh - var(--application-header-height)) !important;
+    margin-left: var(--application-rail-width) !important;
+    padding: 18px clamp(18px, 2vw, 30px) 48px !important;
+    overflow: visible !important;
+    background: transparent !important;
+  }
+
+  html[data-visual-theme] body .monday-shell-phase-1.desktop-rail-collapsed .application-main {
+    width: calc(100% - var(--application-rail-collapsed-width)) !important;
+    margin-left: var(--application-rail-collapsed-width) !important;
+  }
+
+  .monday-navigation-rail {
+    inset: var(--application-header-height) auto 0 0 !important;
+    width: var(--application-rail-width) !important;
+    min-width: var(--application-rail-width) !important;
+    padding: 8px 8px 12px !important;
+    border-right: 1px solid var(--monday-divider) !important;
+    background: var(--monday-shell-bg) !important;
+    box-shadow: none !important;
+    scrollbar-color: color-mix(in srgb, var(--monday-muted) 30%, transparent) transparent;
+  }
+
+  .monday-navigation-rail.is-collapsed {
+    width: var(--application-rail-collapsed-width) !important;
+    min-width: var(--application-rail-collapsed-width) !important;
+    padding-inline: 6px !important;
+  }
+
+  .monday-navigation-rail .desktop-rail-heading {
+    align-items: flex-start;
+    min-height: 52px;
+    padding: 0 0 8px !important;
+    border-bottom: 1px solid var(--monday-divider) !important;
+  }
+
+  .monday-navigation-rail .desktop-rail-collapse {
+    width: 36px;
+    height: 36px;
+    margin-top: 5px;
+    border-color: transparent;
+    border-radius: 8px;
+    background: transparent;
+  }
+
+  .monday-navigation-rail .desktop-rail-collapse:hover,
+  .monday-navigation-rail .desktop-rail-collapse:focus-visible {
+    border-color: var(--monday-divider);
+    background: var(--monday-hover);
+  }
+
+  .monday-workspace-switcher {
+    position: relative;
+    min-width: 0;
+    flex: 1 1 auto;
+  }
+
+  .monday-workspace-switcher > summary {
